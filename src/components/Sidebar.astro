    databases: `<svg viewBox="0 0 25.6 25.6"><g fill="#336791"><path d="M18.983 18.636c.163-1.357.114-1.555 1.124-1.336l.257.023c.777.035 1.793-.125 2.392-.403 1.285-.596 2.049-1.593.781-1.331-2.893.597-3.091-.383-3.091-.383 3.053-4.534 4.332-10.289 3.228-11.696-3.005-3.84-8.209-2.024-8.296-1.977l-.028.005a10.31 10.31 0 0 0-1.929-.201c-1.308-.021-2.302.343-3.055.914 0 0-9.277-3.823-8.846 4.808.092 1.836 2.632 13.9 5.661 10.255 1.107-1.332 2.178-2.458 2.178-2.458a4.22 4.22 0 0 0 1.835.469l.052-.044c-.016.165-.009.327.021.519-.781.872-.551 1.025-2.112 1.346-1.579.326-.651.905-.046 1.056.734.184 2.432.444 3.58-1.163l-.046.183c.306.245.52 1.593.483 2.815-.036 1.222-.06 2.062.181 2.717.241.655.481 2.131 2.531 1.691 1.714-.367 2.602-.896 2.726-2.893z"/></g></svg>`,
