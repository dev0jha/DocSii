---
import { getCollection } from "astro:content";

const allNotes = await getCollection("notes", ({ data }) => !data.draft);

type CategoryGroup = {
  category: string;
  topics: Map<string, { slug: string; title: string; order: number }[]>;
};

const grouped = allNotes.reduce<Map<string, CategoryGroup>>((acc, note) => {
  const { category, topic, title, order } = note.data;
  if (!acc.has(category)) {
    acc.set(category, { category, topics: new Map() });
  }
  const group = acc.get(category)!;
  const topicKey = topic || "__untopiced__";
  if (!group.topics.has(topicKey)) {
    group.topics.set(topicKey, []);
  }
  group.topics.get(topicKey)!.push({
    slug: note.id,
    title,
    order,
  });
  return acc;
}, new Map());

const sortedCategories = [...grouped.values()].sort((a, b) =>
  a.category.localeCompare(b.category)
);

for (const group of sortedCategories) {
  for (const [, notes] of group.topics) {
    notes.sort((a, b) => a.order - b.order);
  }
}

const currentSlug = Astro.params.slug;

function formatTopic(topic: string) {
  if (topic === "tanstackquery") return "TanStack Query";
  if (topic === "react") return "React";
  if (topic === "javascript") return "JavaScript";
  if (topic === "python") return "Python";
  if (topic === "docker") return "Docker";
  if (topic === "databases") return "Databases";
  if (topic === "git-and-github") return "Git & GitHub";
  return topic.charAt(0).toUpperCase() + topic.slice(1);
}

