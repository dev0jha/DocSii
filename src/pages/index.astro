---
import Layout from "@/layouts/Layout.astro";
import { getCollection } from "astro:content";
import { HeroSection } from "@/components/hero";
import { CategorySlider } from "@/components/category-slider";
import HeroSearchWrapper from "@/components/HeroSearchWrapper.astro";

const notes = await getCollection("notes", ({ data }) => !data.draft);

const totalNotes = notes.length;
const totalTopics = [...new Set(notes.map((n) => n.data.topic).filter(Boolean))].length;
---

<Layout title="Home" description="Curated technical notes by Dev Hari Ojha">
  <div class="landing">

    <!-- Hero (efferd hero-1) with search -->
    <section class="landing-hero-wrapper">
      <HeroSection totalNotes={totalNotes} totalTopics={totalTopics} client:load>
        <div class="hero-search-dark">
          <HeroSearchWrapper />
        </div>
      </HeroSection>
    </section>

    <!-- Browse by Category -->
    <section class="landing-categories-wrapper">
      <h2 class="landing-categories-heading">
        Browse by <span class="heading-accent">Category</span>
      </h2>
      <div class="landing-slider-wrap">
        <CategorySlider client:load />
      </div>
    </section>

    <!-- Why Use DocSii -->
    <section class="landing-why-use">
      <h2 class="why-use-heading">Ensuring your <span class="heading-accent">speedy learning</span></h2>
      
      <div class="why-use-grid-wrap">
        <div class="why-use-grid">
          <!-- Corner plus signs -->
          <span class="grid-corner top-left">+</span>
          <span class="grid-corner top-right">+</span>
          <span class="grid-corner bottom-left">+</span>
          <span class="grid-corner bottom-right">+</span>
          
          <!-- Column 1: Offline-First Speed -->
          <div class="why-use-col">
            <div class="why-use-icon-wrap">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="why-use-icon">
                <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path>
                <path d="M3 3v5h5"></path>
                <line x1="12" y1="7" x2="12" y2="12"></line>
                <line x1="12" y1="12" x2="16" y2="14"></line>
              </svg>
            </div>
            <h3 class="why-use-title">Offline-First Speed</h3>
            <p class="why-use-desc">Zero loading states, instant access, and fully offline-capable reference.</p>
          </div>
          
          <!-- Column 2: Curated Technical Notes -->
          <div class="why-use-col">
            <div class="why-use-icon-wrap">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="why-use-icon">
                <rect x="3" y="3" width="7" height="9" rx="1"></rect>
                <rect x="14" y="3" width="7" height="5" rx="1"></rect>
                <rect x="14" y="12" width="7" height="9" rx="1"></rect>
                <rect x="3" y="16" width="7" height="5" rx="1"></rect>
              </svg>
            </div>
            <h3 class="why-use-title">Curated Technical Notes</h3>
            <p class="why-use-desc">Perfect cheat sheets for databases, languages, and modern tools.</p>
          </div>
          
          <!-- Column 3: Keyboard Shortcuts -->
          <div class="why-use-col">
            <div class="why-use-icon-wrap">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="why-use-icon">
                <path d="M18 3a3 3 0 0 0-3 3v12a3 3 0 0 0 3 3 3 3 0 0 0 3-3 3 3 0 0 0-3-3H6a3 3 0 0 0-3 3 3 3 0 0 0 3 3 3 3 0 0 0 3-3V6a3 3 0 0 0-3-3 3 3 0 0 0-3 3 3 3 0 0 0 3 3h12a3 3 0 0 0 3-3 3 3 0 0 0-3-3z"></path>
              </svg>
            </div>
            <h3 class="why-use-title">Keyboard Shortcuts</h3>
            <p class="why-use-desc">Navigate documentation fluidly without touching your mouse.</p>
          </div>
        </div>
      </div>
    </section>
  </div>
</Layout>

<style>
  /* ─── Landing page layout ─── */
  .landing {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    background-color: #0c0b09;
    color: #ffffff;
  }

  /* ─── Hero Wrapper ─── */
  .landing-hero-wrapper {
    position: relative;
    overflow: hidden;
    background-color: #0c0b09;
  }

  /* ─── Search Dark Theme Override ─── */
  .hero-search-dark :global(.hero-search-input-wrap) {
    background: transparent;
    border-color: rgba(255, 255, 255, 0.15);
  }
  .hero-search-dark :global(.hero-search-input-wrap:focus-within) {
    border-color: #f54e00;
    box-shadow: 0 0 0 3px rgba(245, 78, 0, 0.15);
  }
  .hero-search-dark :global(.hero-search-input) {
    color: #ffffff;
  }
  .hero-search-dark :global(.hero-search-input::placeholder) {
    color: rgba(255, 255, 255, 0.35);
  }
  .hero-search-dark :global(.hero-search-icon) {
    color: rgba(255, 255, 255, 0.35);
  }
  .hero-search-dark :global(.hero-search-kbd) {
    background: rgba(255, 255, 255, 0.06);
    border-color: rgba(255, 255, 255, 0.15);
    color: rgba(255, 255, 255, 0.5);
  }
  .hero-search-dark :global(.hero-search-dropdown) {
    background: #1a1916;
    border-color: rgba(255, 255, 255, 0.1);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.5);
  }
  .hero-search-dark :global(.hero-search-result) {
    color: #efeee8;
  }
  .hero-search-dark :global(.hero-search-result:hover),
  .hero-search-dark :global(.hero-search-result.selected) {
    background: rgba(255, 255, 255, 0.06);
  }
  .hero-search-dark :global(.hero-search-result-icon) {
    background: rgba(255, 255, 255, 0.08);
    color: rgba(255, 255, 255, 0.5);
  }
  .hero-search-dark :global(.hero-search-result-title) {
    color: #efeee8;
  }
  .hero-search-dark :global(.hero-search-result-meta) {
    color: rgba(255, 255, 255, 0.4);
  }
  .hero-search-dark :global(.hero-search-result-arrow) {
    color: rgba(255, 255, 255, 0.2);
  }
  .hero-search-dark :global(.hero-search-empty) {
    color: rgba(255, 255, 255, 0.4);
  }

  /* ─── Category Slider Section ─── */
  .landing-categories-wrapper {
    position: relative;
    padding: 24px 0 40px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    background-color: #0c0b09;
  }
  .landing-categories-heading {
    text-align: center;
    font-size: 18px;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.5);
    margin: 0 0 16px;
    letter-spacing: -0.2px;
  }
  .heading-accent {
    color: #ffffff;
    font-weight: 600;
  }
  .landing-slider-wrap {
    position: relative;
    z-index: 10;
    max-width: 900px;
    margin: 0 auto;
  }

  /* ─── Why Use Section ─── */
  .landing-why-use {
    background-color: #0c0b09;
    padding: 80px 24px 120px;
    display: flex;
    flex-direction: column;
    align-items: center;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }
  .why-use-heading {
    font-size: 32px;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.5);
    text-align: center;
    margin-bottom: 48px;
    letter-spacing: -0.6px;
  }
  .why-use-grid-wrap {
    width: 100%;
    max-width: 900px;
    position: relative;
  }
  .why-use-grid {
    display: grid;
    grid-template-columns: 1fr;
    border: 1px dashed rgba(255, 255, 255, 0.15);
    position: relative;
  }
  
  /* Plus marks at corners */
  .grid-corner {
    position: absolute;
    width: 16px;
    height: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(255, 255, 255, 0.35);
    font-family: monospace, sans-serif;
    font-size: 16px;
    font-weight: 300;
    line-height: 1;
    pointer-events: none;
    z-index: 5;
  }
  .grid-corner.top-left {
    top: 0;
    left: 0;
    transform: translate(-50%, -50%);
  }
  .grid-corner.top-right {
    top: 0;
    right: 0;
    transform: translate(50%, -50%);
  }
  .grid-corner.bottom-left {
    bottom: 0;
    left: 0;
    transform: translate(-50%, 50%);
  }
  .grid-corner.bottom-right {
    bottom: 0;
    right: 0;
    transform: translate(50%, 50%);
  }
  
  /* Columns */
  .why-use-col {
    padding: 32px 28px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
    transition: background-color 0.2s ease;
  }
  .why-use-col:not(:last-child) {
    border-bottom: 1px dashed rgba(255, 255, 255, 0.15);
  }
  .why-use-icon-wrap {
    margin-bottom: 16px;
    color: rgba(255, 255, 255, 0.45);
    transition: color 0.2s ease, transform 0.2s ease;
  }
  .why-use-col:hover .why-use-icon-wrap {
    color: #f54e00;
    transform: translateY(-2px);
  }
  .why-use-title {
    font-size: 18px;
    font-weight: 600;
    color: #ffffff;
    margin: 0 0 8px;
    letter-spacing: -0.2px;
  }
  .why-use-desc {
    font-size: 14px;
    color: rgba(255, 255, 255, 0.4);
    line-height: 1.5;
    margin: 0;
  }
  
  /* Desktop Layout Overrides */
  @media (min-width: 768px) {
    .why-use-grid {
      grid-template-columns: repeat(3, 1fr);
    }
    .why-use-col {
      padding: 48px 36px;
    }
    .why-use-col:not(:last-child) {
      border-bottom: none;
      border-right: 1px dashed rgba(255, 255, 255, 0.15);
    }
  }
</style>
